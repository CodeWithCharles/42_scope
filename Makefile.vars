# ============================================================================
# Makefile.vars
# ----------------------------------------------------------------------------
# FR: Variables de configuration, profils de build et flags par OS.
# EN: Configuration variables, build profiles and OS-specific flags.
# ============================================================================

SHELL := /bin/sh

# ----------------------------------------------------------------------------
# Verbose / quiet mode
# ----------------------------------------------------------------------------
# FR: `make VERBOSE=1` ou `make V=1` affiche toutes les commandes.
# EN: `make VERBOSE=1` or `make V=1` prints the full command lines.
VERBOSE ?= 0
V ?= $(VERBOSE)
Q := $(if $(filter 1 yes true TRUE YES,$(strip $(V))),,@)

# ----------------------------------------------------------------------------
# Toolchain and user-configurable paths
# ----------------------------------------------------------------------------
# FR: Ces variables sont surchargeables en ligne de commande.
# EN: These variables can be overridden from the command line.
PROJECT_DIR := $(CURDIR)

CC        ?= cc
CXX       ?= c++
CFLAGS    ?= -std=c17 -Wall -Wextra -Wpedantic
CXXFLAGS  ?= -std=c++17 -Wall -Wextra -Wpedantic
CPPFLAGS  ?=
LDFLAGS   ?=
INCLUDES  ?= -I$(INC_DIR)
LIBS      ?=

BUILD_DIR ?= build
SRC_DIR   ?= src
INC_DIR   ?= include
ASSET_DIR ?= assets
SHADER_DIR ?= $(ASSET_DIR)/shaders
DEPS_DIR ?= deps
THIRD_PARTY_DIR ?= $(DEPS_DIR)
LOCAL_DIR ?= $(DEPS_DIR)/local
BUILD_TYPE ?= debug
OBJ_DIR   ?= $(BUILD_DIR)/$(BUILD_TYPE)/obj
BIN_NAME  ?= scop

# ----------------------------------------------------------------------------
# Local third-party dependencies
# ----------------------------------------------------------------------------
# FR: Les dependances sont telechargees / compilees dans le projet uniquement.
# EN: Dependencies are fetched / built inside the project only.
GLFW_GIT ?= https://github.com/glfw/glfw.git
GLFW_SRC_DIR ?= $(DEPS_DIR)/glfw
GLFW_BUILD_DIR ?= $(DEPS_DIR)/build/glfw/$(BUILD_TYPE)
LOCAL_INCLUDE_DIR ?= $(LOCAL_DIR)/include
LOCAL_LIB_DIR ?= $(LOCAL_DIR)/lib
GLFW_LOCAL_LIB ?= $(LOCAL_LIB_DIR)/libglfw3.a
GLFW_CMAKE_BUILD_TYPE = $(if $(filter release,$(BUILD_TYPE)),Release,Debug)

GLAD_DIR ?= $(DEPS_DIR)/glad
GLAD_INC_DIR ?= $(GLAD_DIR)/include
GLAD_SRC_DIR ?= $(GLAD_DIR)/src
GLAD_HEADER ?= $(GLAD_INC_DIR)/glad/glad.h
GLAD_KHR_HEADER ?= $(GLAD_INC_DIR)/KHR/khrplatform.h
GLAD_SOURCE ?= $(GLAD_SRC_DIR)/glad.c

LOCAL_LIBS ?= $(GLFW_LOCAL_LIB)

# ----------------------------------------------------------------------------
# Install directories
# ----------------------------------------------------------------------------
# FR: Pour installer le profil release :
#     `make BUILD_TYPE=release install PREFIX=$(LOCAL_DIR)`
# EN: To install the release profile:
#     `make BUILD_TYPE=release install PREFIX=$(LOCAL_DIR)`
PREFIX  ?= $(LOCAL_DIR)
DESTDIR ?=
INSTALL ?= install

# ----------------------------------------------------------------------------
# Derived build paths
# ----------------------------------------------------------------------------
BUILD_MODE_DIR = $(BUILD_DIR)/$(BUILD_TYPE)
DEP_DIR = $(BUILD_MODE_DIR)/dep
TARGET = $(BUILD_MODE_DIR)/$(BIN_NAME)
ASSET_BUILD_DIR = $(BUILD_MODE_DIR)/assets
INSTALL_BIN_DIR = $(DESTDIR)$(PREFIX)/bin
INSTALL_SHARE_DIR = $(DESTDIR)$(PREFIX)/share/$(BIN_NAME)
DOCTOR_DIR = $(BUILD_DIR)/doctor

# ----------------------------------------------------------------------------
# Build profiles
# ----------------------------------------------------------------------------
DEBUG_CFLAGS     ?= -O0 -g3 -DDEBUG
DEBUG_CXXFLAGS   ?= -O0 -g3 -DDEBUG
DEBUG_LDFLAGS    ?=
RELEASE_CFLAGS   ?= -O3 -DNDEBUG
RELEASE_CXXFLAGS ?= -O3 -DNDEBUG
RELEASE_LDFLAGS  ?=

BUILD_CFLAGS   = $(if $(filter release,$(BUILD_TYPE)),$(RELEASE_CFLAGS),$(DEBUG_CFLAGS))
BUILD_CXXFLAGS = $(if $(filter release,$(BUILD_TYPE)),$(RELEASE_CXXFLAGS),$(DEBUG_CXXFLAGS))
BUILD_LDFLAGS  = $(if $(filter release,$(BUILD_TYPE)),$(RELEASE_LDFLAGS),$(DEBUG_LDFLAGS))

# ----------------------------------------------------------------------------
# Platform-specific flags
# ----------------------------------------------------------------------------
# FR: GLFW est clone, compile et installe dans `deps/`. GLAD est attendu dans
#     `deps/glad` (package genere, avec `include/` et `src/glad.c`).
#     Les bibliotheques systeme restantes (OpenGL, X11, frameworks Apple)
#     restent celles de l'OS.
# EN: GLFW is cloned, built and installed under `deps/`. GLAD is expected in
#     `deps/glad` (generated package, with `include/` and `src/glad.c`).
#     Remaining system libraries (OpenGL, X11, Apple frameworks) still come
#     from the OS.
UNAME_S := $(shell uname -s 2>/dev/null || printf 'Unknown')
LOCAL_CPPFLAGS := -I$(LOCAL_INCLUDE_DIR) -I$(GLAD_INC_DIR)
OS_CFLAGS :=
OS_CXXFLAGS :=
OS_CPPFLAGS :=
OS_LDFLAGS :=
OS_LIBS :=
DOCTOR_SYS_LIBS :=

ifeq ($(UNAME_S),Linux)
OS_CFLAGS += -fPIE
OS_CXXFLAGS += -fPIE
OS_LDFLAGS += -pie
OS_LIBS += $(GLFW_LOCAL_LIB) -lGL -ldl -lpthread -lm -lX11 -lXrandr -lXi -lXxf86vm -lXinerama -lXcursor
DOCTOR_SYS_LIBS += -lGL -ldl -lpthread -lm -lX11 -lXrandr -lXi -lXxf86vm -lXinerama -lXcursor
endif

ifeq ($(UNAME_S),Darwin)
OS_LIBS += $(GLFW_LOCAL_LIB) -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo
DOCTOR_SYS_LIBS += -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo
endif

CPPFLAGS += $(INCLUDES) $(LOCAL_CPPFLAGS) $(OS_CPPFLAGS)
CFLAGS   += $(OS_CFLAGS)
CXXFLAGS += $(OS_CXXFLAGS)
LDFLAGS  += $(OS_LDFLAGS)
LIBS     += $(OS_LIBS)

# ----------------------------------------------------------------------------
# GLAD reminder
# ----------------------------------------------------------------------------
# FR: Generez GLAD OpenGL 4.1 sur https://gen.glad.sh/ puis placez:
#       - $(GLAD_SOURCE)
#       - $(GLAD_HEADER)
#       - $(GLAD_KHR_HEADER)
#     Le Makefile compilera automatiquement `glad.c` depuis ce dossier.
# EN: Generate OpenGL 4.1 GLAD at https://gen.glad.sh/ then place:
#       - $(GLAD_SOURCE)
#       - $(GLAD_HEADER)
#       - $(GLAD_KHR_HEADER)
#     The Makefile will automatically compile `glad.c` from that location.

# ----------------------------------------------------------------------------
# Tooling for local GLFW build
# ----------------------------------------------------------------------------
CMAKE ?= cmake
GIT ?= git
